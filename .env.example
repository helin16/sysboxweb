# Copy this file to .env.local for local development and fill in the values.
# .env.local is ignored by git, so real keys never end up in the repository.
# In production these are set in Vercel → Settings → Environment Variables.

# Google Places API (New) key, used by /api/google-reviews to show Google reviews.
# Restrict it to "Places API (New)" in Google Cloud Console → Credentials.
GOOGLE_PLACES_API_KEY=
